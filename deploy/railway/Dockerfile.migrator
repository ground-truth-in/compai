# Comp AI — Database migrator (one-shot). Railway builds the last stage.
# Run once before app/portal/api, or on each schema release.

FROM oven/bun:1.2.8

WORKDIR /app

COPY packages/db/prisma ./packages/db/prisma

RUN echo '{"name":"migrator","type":"module","dependencies":{"prisma":"^6.14.0","@prisma/client":"^6.14.0","@trycompai/db":"^1.3.4","zod":"^3.25.7"}}' > package.json \
  && bun install \
  && cp -R packages/db/prisma/migrations node_modules/@trycompai/db/dist/

CMD ["bunx", "prisma", "migrate", "deploy", "--schema=node_modules/@trycompai/db/dist/schema.prisma"]
