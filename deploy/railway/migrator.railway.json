{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile.migrator",
    "watchPatterns": [
      ".dockerignore",
      "packages/db/prisma/**",
      "deploy/railway/Dockerfile.migrator"
    ]
  },
  "deploy": {
    "restartPolicyType": "NEVER",
    "restartPolicyMaxRetries": 0
  }
}
