{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile.multistage",
    "watchPatterns": [
      "package.json",
      "bun.lock",
      ".dockerignore",
      "apps/api/**",
      "apps/api/Dockerfile.multistage",
      "packages/auth/**",
      "packages/db/**",
      "packages/billing/**",
      "packages/email/**",
      "packages/company/**",
      "packages/integration-platform/**",
      "packages/utils/**",
      "packages/tsconfig/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
