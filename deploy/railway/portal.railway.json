{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile.portal",
    "watchPatterns": [
      "package.json",
      "bun.lock",
      ".dockerignore",
      "Dockerfile",
      "apps/portal/**",
      "packages/**",
      "deploy/railway/Dockerfile.portal"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
